# ---------------------------------------------------------------------------
# apps/web — browser environment.
#
# Only variables prefixed VITE_ are exposed to the browser bundle. NEVER put a
# secret here: everything in this file ends up readable in the shipped
# JavaScript. The API keys this product needs (OpenRouteService) live in
# apps/api/.env and are used server-side.
#
# Copy to `.env` and edit. Every variable below has a working default, so the
# app runs with no `.env` at all.
#
# The typed declarations for these variables are in `src/env.d.ts` — add a
# variable there as well as here.
# ---------------------------------------------------------------------------

# Base URL for the qualroteiro HTTP API.
#
# Leave unset in development. The app then calls the relative path `/api/...`,
# and the Vite dev server proxies `/api` to the API origin below, stripping the
# `/api` prefix (the API exposes `/routes/plan`, not `/api/routes/plan`). Keeping
# requests same-origin in development means no CORS preflight, and a
# misconfigured proxy fails loudly as a 404 instead of quietly as an opaque CORS
# error.
#
# In development this doubles as the *proxy target* (see vite.config.ts);
# for a deployed build, set it to the API's public origin, e.g.
#   VITE_API_BASE_URL="https://api.qualroteiro.com.br"
VITE_API_BASE_URL="http://localhost:3000"

# Build-time demo mode.
#
# Default: unset / "false" — the app behaves exactly as in production: it calls
# the relative `/api/...` path (proxied in dev, a real backend in prod).
#
# Set to "true" ONLY for a build:
#   VITE_DEMO_MODE=true pnpm --filter @qualroteiro/web build
# The resulting `dist/` is a self-contained static site: the fetch layer makes
# no network request and answers `POST /routes/plan` and `GET /places/search`
# from bundled fixtures for the three seeded corridors (SP↔RJ, SP↔Curitiba,
# SP↔Campinas). A "modo demonstração" badge is shown so fixture data is never
# mistaken for real. See apps/web/README.md and specs/004-web-demo-mode.
#
# `import.meta.env.VITE_DEMO_MODE` is inlined at build time, so this is a
# build-time switch, not a runtime one — a production build with it unset drops
# all demo code.
VITE_DEMO_MODE="false"

# MapLibre style document.
#
# Default is OpenFreeMap's "liberty" style, which needs no API key or account —
# so a new contributor gets a working map with an empty `.env`. MapLibre's own
# demo tiles (https://demotiles.maplibre.org/style.json) are a lighter-weight
# alternative with far less detail. Swap for a paid vendor's style URL in
# production if usage grows past what a free service should carry.
VITE_MAP_STYLE_URL="https://tiles.openfreemap.org/styles/liberty"
