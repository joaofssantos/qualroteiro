# ---------------------------------------------------------------------------
# Infrastructure — owned and injected by qualroteiro/root.
# The api unit consumes these; it does not define or change them.
# None of them are required by the F1 "Rota & Custos" endpoints, which are
# stateless and route through the managed provider below.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://qualroteiro:qualroteiro@localhost:5432/qualroteiro?schema=public"
REDIS_URL="redis://localhost:6379"
VALHALLA_URL="http://localhost:8002"
PHOTON_URL="http://localhost:2322"
PORT=3000

# ---------------------------------------------------------------------------
# OpenRouteService — the approved F1 default for routing AND geocoding.
# One key serves both the directions API and the Pelias geocoder.
# Get a free key at https://openrouteservice.org/dev/#/signup
# Required: the server refuses to start without ORS_API_KEY.
# ---------------------------------------------------------------------------
ORS_API_KEY="replace-me-with-your-openrouteservice-api-key"

# Base URL for both ORS APIs. Override only to point at a self-hosted instance
# or a mock; the default below is the public managed endpoint.
ORS_BASE_URL="https://api.openrouteservice.org"
