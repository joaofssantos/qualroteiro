# ---------------------------------------------------------------------------
# Infrastructure — owned and injected by qualroteiro/root.
# The api unit consumes these; it does not define or change them.
# None of them are required by the F1 "Rota & Custos" endpoints, which are
# stateless and route through the managed provider below.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://qualroteiro:qualroteiro@localhost:5432/qualroteiro?schema=public"
REDIS_URL="redis://localhost:6379"
VALHALLA_URL="http://localhost:8002"
PHOTON_URL="http://localhost:2322"
PORT=3000

# ---------------------------------------------------------------------------
# OpenRouteService — the approved F1 default for routing AND geocoding.
# One key serves both the directions API and the Pelias geocoder.
# Get a free key at https://openrouteservice.org/dev/#/signup
# Required: the server refuses to start without ORS_API_KEY.
# ---------------------------------------------------------------------------
ORS_API_KEY="replace-me-with-your-openrouteservice-api-key"

# Base URL for both ORS APIs. Override only to point at a self-hosted instance
# or a mock; the default below is the public managed endpoint.
ORS_BASE_URL="https://api.openrouteservice.org"

# ---------------------------------------------------------------------------
# Clerk — the user store for F2a ("Planejamento de Viagem").
# Clerk IS the user store: there is no local User table, and Trip.userId holds
# the Clerk user id (the token's `sub` claim) as a plain string.
#
# This is the BACKEND secret key (`sk_test_…` / `sk_live_…`), not the
# publishable key — apps/web uses VITE_CLERK_PUBLISHABLE_KEY, a different
# value from a different half of the dashboard. Never commit the real one:
# apps/api/.env is gitignored, this file holds a placeholder only.
#
# Required for the /trips* endpoints: the server refuses to start without it.
# F1 (/routes/plan, /places/search, /health) stays anonymous and needs none of
# this — but the server boots as one process, so the key must be present.
# ---------------------------------------------------------------------------
CLERK_SECRET_KEY="replace-me-with-your-clerk-backend-secret-key"

# ---------------------------------------------------------------------------
# Google Places (New) — Nearby Search, for GET /places/nearby (G1).
#
# Real pricing, not an estimate: Nearby Search grants 5,000 free calls/month,
# then US$25.60/1000. GOOGLE_PLACES_SEARCH_MONTHLY_CAP is our OWN circuit
# breaker's ceiling, deliberately BELOW the free tier with a safety margin —
# once the current UTC month's persisted call count reaches it, the server
# answers 503 and refuses to call Google at all, before spending a cent.
#
# Get a key at https://console.cloud.google.com/apis/credentials with
# "Places API (New)" enabled. Required: the server refuses to start without
# GOOGLE_PLACES_API_KEY. Never commit the real key — apps/api/.env is
# gitignored, this file holds a placeholder only.
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY="replace-me-with-your-google-places-api-key"

# Optional. Defaults to 4500 (Google's free tier is 5,000/month) when unset.
GOOGLE_PLACES_SEARCH_MONTHLY_CAP=4500
