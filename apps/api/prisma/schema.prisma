generator client {
  provider        = "prisma-client-js"
  // Required for the `extensions` property on the datasource below. Its
  // absence made `prisma validate` fail with P1012 on every commit so far
  // (see specs/005-f2a-trips/plan.md D-511) — which meant `prisma migrate`
  // had never been runnable. F2a is the first feature that needs a table.
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// Spatial columns are managed via raw SQL migrations (Kysely) in the
// geo / routing / pois packages — Prisma models cover the relational schema.

/// F2a "Planejamento de Viagem": a saved plan owned by one Clerk user.
///
/// Mirrors the frozen `Trip` type in `@qualroteiro/trips` and
/// `F2-COORDINATION.md` §3.
///
/// `userId` is the Clerk user id as a plain string with NO foreign key and no
/// local `User` table: Clerk is the user store, and mirroring its users into
/// Postgres would create a second copy to keep in sync for no gain here.
model Trip {
  id     String @id @default(uuid())
  userId String

  title String @db.VarChar(200)

  /// ISO `YYYY-MM-DD`, stored as text rather than `DateTime`/`@db.Date` on
  /// purpose: the contract types these `string | null`, and
  /// `@qualroteiro/trips` compares them lexicographically. A timestamp column
  /// would round-trip a date-only value through a timezone, which is how
  /// "2026-10-01" becomes the 30th for a user west of UTC. See plan.md.
  startDate String?
  endDate   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  days TripDay[]

  /// "List my trips" — the only way `GET /trips` ever reads this table, and
  /// also the filter every ownership check applies (plan.md D-508).
  @@index([userId])
}

/// An ordered bucket inside a trip. A null `date` is a deliberately
/// UNSCHEDULED day, not a missing value.
model TripDay {
  id     String @id @default(uuid())
  tripId String

  /// ISO `YYYY-MM-DD` or null. Deliberately NOT constrained to the parent
  /// trip's range — see plan.md D-503 for why that invariant cannot be held.
  date  String?
  order Int

  trip  Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  items TripItem[]

  /// "Days for a trip", plus the cascade's own lookup.
  @@index([tripId])
}

/// One module's saved result placed on a day.
model TripItem {
  id        String @id @default(uuid())
  tripDayId String

  order Int

  /// Which module produced this item (`rota-custos`, and F2b–d as they ship).
  /// Free-form by design — no enum and no allow-list, so a new module needs no
  /// API release and no migration. See plan.md D-502.
  moduleId String @db.VarChar(64)
  kind     String @db.VarChar(64)
  title    String @db.VarChar(200)

  /// The owning module's result, opaque here. `Json` rather than a typed
  /// column is the seam that lets the timeline render and sum items without
  /// knowing what any module produces.
  payload Json

  /// Feeds the consolidated budget. Nullable, and negative is allowed — a
  /// refund or a credit is a real line item (plan.md D-504).
  costEstimate Float?

  day TripDay @relation(fields: [tripDayId], references: [id], onDelete: Cascade)

  @@index([tripDayId])
}

/// G1 "Google Places: busca real + guarda de custo" — a persisted monthly call
/// counter, one row per (SKU, calendar month), that the circuit breaker reads
/// BEFORE calling an external API and increments only AFTER a call actually
/// completes.
///
/// `sku` names the specific paid operation (`places-nearby-search`), not the
/// vendor broadly: Nearby Search, Place Details and Autocomplete are three
/// different Google Places operations with three different prices and three
/// different free tiers, so one shared counter would either over- or
/// under-count each of them. `yearMonth` is `YYYY-MM` (UTC) text rather than a
/// `DateTime`, for the same reason `Trip.startDate` is (see above): it is
/// compared and matched as a whole calendar-month key, never as a point in
/// time, and a timestamp column would invite exactly the timezone bug that
/// text avoids.
///
/// See `apps/api/specs/006-g1-google-places/plan.md` for why the increment is
/// a `count: { increment: 1 }` upsert and never a read-then-write: two
/// concurrent requests in the same month must not race past each other and
/// both land on the count the first one read.
model ApiUsageCounter {
  /// The paid operation this row counts, e.g. `places-nearby-search`.
  sku String

  /// The calendar month (UTC) this count belongs to, as `YYYY-MM`.
  yearMonth String

  /// Successful calls for `sku` in `yearMonth`. Only incremented after
  /// `googlePlaces.searchNearby` resolves without throwing — a call the
  /// circuit breaker refuses before it ever reaches the adapter does not
  /// count here, and neither does one that reaches Google Places but fails
  /// (see `places-nearby.ts`'s `try`/`catch` around the adapter call for the
  /// exact boundary).
  count Int @default(0)

  /// One counter per SKU per month — the row the breaker reads and the
  /// upsert's own conflict target.
  @@unique([sku, yearMonth])
}

/// T5 Wave 2 "Pedágio real, Fase 1 (geo/identidade)": one row per real-world
/// toll plaza, as published monthly by ANTT
/// (`dados.antt.gov.br/dataset/praca-de-pedagio`). Geography and identity
/// only — see `apps/api/specs/007-t5-wave2-toll-plazas/spec.md` for why a
/// tariff column is deliberately NOT here: ANTT's own dataset carries none
/// (each concessionaire publishes its own fare table separately), so pricing
/// is a distinct, later phase.
///
/// Written by `services/data-ingest`'s monthly ingestion job (Wave 3),
/// pointed at THIS schema (`prisma generate --schema=apps/api/prisma/schema.prisma`)
/// rather than defining its own — see `orientation.md` decision 4, one schema
/// per database. Read by `apps/api`'s `TollPlazaStore` — `listActive()` feeds
/// `matchTolls`'s `plazas` list in `routes/plan.ts`, replacing the in-package
/// demo seed on the production path.
model TollPlazaRecord {
  /// Stable natural key, NOT a surrogate id: ANTT's dataset has no numeric id
  /// of its own, so the ingestion job assembles one — a slug of
  /// concessionaire + plaza name + highway + km. Stable across re-ingestion
  /// (the same physical plaza in next month's CSV slugs to the same id, so a
  /// re-run upserts rather than duplicates) and human-legible in a `psql`
  /// session, unlike a hash. Exact slugging (casing, separator, accent
  /// stripping) is Wave 3's decision to make and document when it writes the
  /// first row — this column only requires the value to be stable and unique.
  id String @id

  concessionaire String
  name           String
  highway        String
  uf             String @db.VarChar(2)
  municipality   String
  km             Float
  lat            Float
  lng            Float

  /// Mirrors the ANTT dataset's `situacao` column as of the most recent
  /// ingestion (`true` for `'Ativo'`). `listActive()` filters on this rather
  /// than deleting inactive rows, so a plaza that ANTT later reactivates
  /// re-upserts onto the same natural key instead of losing its history.
  active Boolean

  /// When this row was last written — by the Wave 3 job, or, before that job
  /// exists, by whatever inserted the row (e.g. a one-off verification
  /// script). `GET /admin/toll-plazas-status` reports the most recent value
  /// of this column across every row, so an operator can see how stale the
  /// data is without needing database access.
  ingestedAt DateTime

  /// `listActive()`'s own filter — the only way `/routes/plan` ever reads
  /// this table.
  @@index([active])
}
