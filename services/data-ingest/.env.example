# ---------------------------------------------------------------------------
# services/data-ingest — same infrastructure `apps/api` already uses.
# Local values below match `infra/docker-compose.yml` (root-owned).
# ---------------------------------------------------------------------------

# Read by the Prisma Client generated from `apps/api/prisma/schema.prisma`
# (see `src/prisma-client.ts`). Same database `apps/api` reads from —
# this job is the writer, the API is the reader. Value copied verbatim from
# `apps/api/.env.example` — override the port locally (e.g. `:5433`) if
# another Postgres on your machine already holds 5432, same as `apps/api`.
DATABASE_URL="postgresql://qualroteiro:qualroteiro@localhost:5432/qualroteiro?schema=public"

# BullMQ's connection for the `ingest-toll-plazas`/`ingest-toll-plazas-osm`
# queue/worker (`src/queue.ts`). Only needed by `pnpm worker` (the scheduled
# path) — `pnpm ingest:once`/`pnpm ingest:osm:once` (the CLI/seed paths)
# never touch Redis.
REDIS_URL="redis://localhost:6379"

# No env var needed for the OSM job (`ingest-toll-plazas-osm`) — the
# Overpass API (`src/overpass.ts`) is free, keyless, public infrastructure.
# DATABASE_URL above is all it needs to write into.
