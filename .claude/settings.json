{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "aipe session-context --workspace \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "aipe session-context --release --workspace \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ]
  }
}
